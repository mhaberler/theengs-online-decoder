# Local settings. Copy to .env (gitignored) and fill in.
#
# Deploy settings are consumed by scripts/deploy-web.sh (process-env overrides
# win); the app signing settings by
#   scripts/sync-app-secrets.sh --env-file .env
# which pushes them into the repo's GitHub Actions secrets.

# --- web deploy (scripts/deploy-web.sh) ---

DEPLOY_HOST=user@example.com
DEPLOY_PATH=/toplevel/apps/theengs-decoder/
DEPLOY_BASE=/apps/theengs-decoder/
DEPLOY_URL=https://example.com/apps/theengs-decoder/

# Optional. Only set if sshd on the target listens on a non-default port.
# DEPLOY_PORT=22

# --- app signing (scripts/sync-app-secrets.sh) ---
# App Store Connect API key (Admin or App Manager role), for iOS cloud signing
# and TestFlight upload. FASTLANE_KEY_PATH/_ID/FASTLANE_ISSUER_ID also work.
ASC_KEY_PATH=~/.secrets.d/AuthKey_XXXXXXXXXX.p8
ASC_KEY_ID=XXXXXXXXXX
ASC_ISSUER_ID=00000000-0000-0000-0000-000000000000

# Android release/upload keystore.
ANDROID_KEYSTORE_PATH=~/.secrets.d/my-upload-key.keystore
ANDROID_KEYSTORE_PASSWORD=*****
ANDROID_KEY_ALIAS=my-key-alias
ANDROID_KEY_PASSWORD=*****
